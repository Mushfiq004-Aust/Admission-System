# Copy this file to ".env" (same folder as docker-compose.yml) and change the values.
# Docker Compose reads ".env" automatically. ".env" is ignored by Git, so real passwords are never committed.
# If you do not create a .env file, the demo defaults shown here are used.

# --- Admin portal login (http://localhost:3000/admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to sign admin login tokens. At least 32 characters. Use a long random value for anything real.
JWT_SECRET=docker-demo-secret-change-me-0123456789abcdef

# How long an admin login stays valid, in minutes.
JWT_EXPIRY_MINUTES=60

# --- Admission ---
# How long a seat is held for a student, in seconds (assignment default: 600 = 10 minutes).
HOLD_DURATION_SECONDS=600

# --- Frontend ---
# Backend address as seen from the BROWSER (never a Docker-internal name like http://backend:8080).
VITE_API_BASE_URL=http://localhost:8080
